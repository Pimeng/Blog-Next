---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { getCategoryList, getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const categories = await getCategoryList();
const totalPosts = (await getSortedPostsList()).length;
const homeUrl = url("/");
const archiveUrl = url("/archive/");
---

<div class="card-base category-bar p-3 onload-animation" id="category-bar" data-home-path={homeUrl} data-archive-path={archiveUrl}>
  <div class="category-bar-inner flex gap-2 items-center">
    <div class="category-navigation flex gap-2 min-w-0">
    <a
      href={homeUrl}
      class="category-pill text-sm px-2 py-1 rounded-lg shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name=""
      aria-label={i18n(I18nKey.home)}
    >
      <Icon name="material-symbols:home" class="text-lg" />
    </a>
    <a
      href={archiveUrl}
      class="category-pill text-sm px-3 py-1 rounded-lg whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__archive__"
    >
      {i18n(I18nKey.archive)}
      <span class="text-xs opacity-60 ml-1">{totalPosts}</span>
    </a>
    <div class="category-divider shrink-0"></div>
    <div class="scroll-area relative">
      <div class="scroll-fade scroll-fade-left" aria-hidden="true"></div>
      <div class="category-scroll flex gap-2 overflow-x-auto">
        {
          categories.map((cat) => (
            <a
              href={cat.url}
              class="category-pill text-sm px-3 py-1 rounded-lg whitespace-nowrap
                     transition-colors duration-150 ease-out flex items-center justify-center"
              data-category-name={cat.name}
            >
              {cat.name}
              <span class="text-xs opacity-60 ml-1">{cat.count}</span>
            </a>
          ))
        }
      </div>
      <div class="scroll-fade scroll-fade-right" aria-hidden="true"></div>
    </div>
    </div>
    <div class="sort-control relative shrink-0">
      <button
        type="button"
        class="sort-trigger category-pill text-sm px-2.5 py-1 rounded-lg whitespace-nowrap
               transition-colors duration-150 ease-out flex items-center justify-center gap-1"
        aria-label={i18n(I18nKey.sortPosts)}
        aria-expanded="false"
        aria-controls="category-sort-menu"
        data-sort-loading-label={i18n(I18nKey.sortLoading)}
      >
        <Icon name="material-symbols:sort-rounded" class="text-lg" aria-hidden="true" />
        <span class="sort-label">{i18n(I18nKey.sortByLatest)}</span>
        <Icon name="material-symbols:keyboard-arrow-down-rounded" class="sort-chevron text-lg" aria-hidden="true" />
      </button>
      <div class="sort-menu" id="category-sort-menu" role="menu" hidden>
        <button
          type="button"
          class="sort-option"
          role="menuitemradio"
          data-sort="latest"
          data-sort-label={i18n(I18nKey.sortByLatest)}
        >
          <Icon name="material-symbols:schedule-rounded" class="text-lg" aria-hidden="true" />
          <span>{i18n(I18nKey.sortByLatest)}</span>
        </button>
        <button
          type="button"
          class="sort-option"
          role="menuitemradio"
          data-sort="oldest"
          data-sort-label={i18n(I18nKey.sortByOldest)}
        >
          <Icon name="material-symbols:history-rounded" class="text-lg" aria-hidden="true" />
          <span>{i18n(I18nKey.sortByOldest)}</span>
        </button>
        <button
          type="button"
          class="sort-option"
          role="menuitemradio"
          data-sort="views"
          data-sort-label={i18n(I18nKey.sortByViews)}
        >
          <Icon name="material-symbols:trending-up-rounded" class="text-lg" aria-hidden="true" />
          <span>{i18n(I18nKey.sortByViews)}</span>
        </button>
        <button
          type="button"
          class="sort-option"
          role="menuitemradio"
          data-sort="views-asc"
          data-sort-label={i18n(I18nKey.sortByLeastViews)}
        >
          <Icon name="material-symbols:trending-down-rounded" class="text-lg" aria-hidden="true" />
          <span>{i18n(I18nKey.sortByLeastViews)}</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .category-bar {
    margin-bottom: 1rem;
    position: relative;
    z-index: 30;
    overflow: visible;
  }
  .category-navigation {
    flex: 1;
  }
  .category-divider {
    width: 1px;
    align-self: stretch;
    background: var(--line-divider);
  }
  .scroll-area {
    flex: 1;
    min-width: 0;
    position: relative;
  }
  .scroll-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease-in-out;
    z-index: 1;
  }
  .scroll-fade[data-visible] {
    opacity: 1;
  }
  .scroll-fade-left {
    left: 0;
    background: linear-gradient(to left, transparent, var(--card-bg));
  }
  .scroll-fade-right {
    right: 0;
    background: linear-gradient(to right, transparent, var(--card-bg));
  }
  :global(body.wallpaper-transparent) .scroll-fade {
    display: none;
  }
  .category-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .category-scroll::-webkit-scrollbar {
    display: none;
  }
  .category-pill {
    border: 1.5px solid var(--line-divider);
    color: var(--btn-content);
    background: transparent;
  }
  .category-pill:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: transparent;
  }
  .category-pill[data-active] {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }
  .category-pill[data-active]:hover {
    background: var(--primary);
    border-color: var(--primary);
    opacity: 0.9;
  }
  .sort-trigger {
    min-height: 2rem;
  }
  .sort-trigger[aria-expanded="true"] {
    border-color: var(--primary);
    color: var(--primary);
  }
  .sort-chevron {
    transition: transform 150ms ease-out;
  }
  .sort-trigger[aria-expanded="true"] .sort-chevron {
    transform: rotate(180deg);
  }
  .sort-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 20;
    min-width: 10.5rem;
    padding: 0.375rem;
    border-radius: var(--radius-large);
    border: 1px solid var(--line-divider);
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 12%);
    overflow: hidden;
    background: var(--card-bg) !important;
    background-color: var(--card-bg) !important;
    transition: background-color 150ms ease-out;
  }
  .sort-option {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    color: var(--btn-content);
    text-align: left;
    white-space: nowrap;
    transition: color 150ms ease-out, background-color 150ms ease-out;
  }
  .sort-option:hover,
  .sort-option[aria-checked="true"] {
    color: var(--primary);
    background: var(--btn-plain-bg-hover);
  }
  .sort-option[aria-checked="true"] {
    font-weight: 600;
  }
  @media (max-width: 560px) {
    .sort-label {
      display: none;
    }
    .sort-trigger {
      padding-inline: 0.5rem;
    }
  }
</style>

<script>
  function getCategoryBarState(bar: HTMLElement, currentUrl: URL) {
    const pathname = currentUrl.pathname.replace(/\/$/, "");
    const homePath = (bar.getAttribute("data-home-path") || "/").replace(/\/$/, "");
    const archivePath = (bar.getAttribute("data-archive-path") || "/archive").replace(/\/$/, "");
    const isHome = pathname === homePath || pathname === "" || pathname === "/";
    const isArchive = pathname === archivePath;
    const escapedHomePath = homePath.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    // 分页页面（如 /2/, /3/）也属于首页的延续
    const isHomePagination =
      /^\/\d+$/.test(pathname) ||
      (homePath !== "" && new RegExp(`^${escapedHomePath}\\/\\d+$`).test(pathname));

    return {
      isHome,
      isArchive,
      isHomePagination,
      activeCategory: currentUrl.searchParams.get("category") || "",
      hasTag: currentUrl.searchParams.has("tag"),
      hasUncategorized: currentUrl.searchParams.has("uncategorized"),
    };
  }

  function setActiveCategory(bar: HTMLElement, currentUrl: URL) {
    const { isHome, isArchive, isHomePagination, activeCategory, hasTag, hasUncategorized } =
      getCategoryBarState(bar, currentUrl);

    // 在首页、首页分页和归档页显示
    if (!isHome && !isHomePagination && !isArchive) {
      bar.style.display = "none";
      return;
    }
    bar.style.display = "";

    const pills = bar.querySelectorAll<HTMLAnchorElement>(".category-pill");
    pills.forEach((pill) => pill.removeAttribute("data-active"));

    if (isHome || isHomePagination) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name=""]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (activeCategory) {
      pills.forEach((pill) => {
        if (pill.getAttribute("data-category-name") === activeCategory) {
          pill.setAttribute("data-active", "");
        }
      });
      return;
    }

    if (isArchive && !hasTag && !hasUncategorized) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__archive__"]')
        ?.setAttribute("data-active", "");
    }
  }

  function scrollActiveCategoryIntoView(bar: HTMLElement, behavior: ScrollBehavior = "smooth") {
    const activePill = bar.querySelector<HTMLAnchorElement>('.category-pill[data-active]');
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (!activePill || !scroll) return;

    const scrollLeft = activePill.offsetLeft - scroll.offsetLeft - (scroll.clientWidth - activePill.offsetWidth) / 2;
    scroll.scrollTo({ left: Math.max(0, scrollLeft), behavior });
  }

  function updateCategoryBar(currentUrl = new URL(window.location.href)) {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    setActiveCategory(bar, currentUrl);
    scrollActiveCategoryIntoView(bar);
  }

  type SortKey = "latest" | "oldest" | "views" | "views-asc";
  const sortKeys = new Set<SortKey>(["latest", "oldest", "views", "views-asc"]);
  let sortRequestId = 0;
  let applyRequestId = 0;

  function isSortKey(value: string | null): value is SortKey {
    return value !== null && sortKeys.has(value as SortKey);
  }

  function getSortPreference(): SortKey {
    const querySort = new URL(window.location.href).searchParams.get("sort");
    if (isSortKey(querySort)) return querySort;

    try {
      const storedSort = localStorage.getItem("firefly-post-sort");
      if (isSortKey(storedSort)) return storedSort;
    } catch {
      // localStorage may be unavailable in private browsing modes.
    }

    return "latest";
  }

  function setSortPreference(sort: SortKey) {
    try {
      localStorage.setItem("firefly-post-sort", sort);
    } catch {
      // localStorage may be unavailable in private browsing modes.
    }

    const currentUrl = new URL(window.location.href);
    if (sort === "latest") {
      currentUrl.searchParams.delete("sort");
    } else {
      currentUrl.searchParams.set("sort", sort);
    }
    window.history.replaceState(window.history.state, "", currentUrl);
  }

  function updateSortUi(sort: SortKey, loading = false) {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    const trigger = bar.querySelector<HTMLButtonElement>(".sort-trigger");
    const label = bar.querySelector<HTMLElement>(".sort-label");
    const options = bar.querySelectorAll<HTMLButtonElement>(".sort-option");
    const activeOption = bar.querySelector<HTMLButtonElement>(`[data-sort="${sort}"]`);

    if (label && activeOption) {
      label.textContent = loading
        ? trigger?.dataset.sortLoadingLabel || ""
        : activeOption.dataset.sortLabel || "";
    }
    options.forEach((option) => {
      option.setAttribute("aria-checked", option.dataset.sort === sort ? "true" : "false");
    });
    trigger?.setAttribute("aria-busy", loading ? "true" : "false");
  }

  function getPageviews(stats: unknown): number {
    if (!stats || typeof stats !== "object") return 0;

    const rawValue = (stats as { pageviews?: unknown }).pageviews;
    if (typeof rawValue === "number") return Number.isFinite(rawValue) ? rawValue : 0;
    if (rawValue && typeof rawValue === "object") {
      const value = (rawValue as { value?: unknown }).value;
      const parsed = Number(value);
      return Number.isFinite(parsed) ? parsed : 0;
    }
    return 0;
  }

  async function getPostViews(post: HTMLElement): Promise<number> {
    const cachedViews = Number(post.dataset.postViews);
    if (Number.isFinite(cachedViews)) return cachedViews;

    const stats = window.FireflyUmamiStats;
    const path = post.dataset.postPath;
    if (!stats?.fetchStats || !path) return 0;

    try {
      const views = getPageviews(await stats.fetchStats(path));
      post.dataset.postViews = String(views);
      return views;
    } catch {
      post.dataset.postViews = "0";
      return 0;
    }
  }

  async function sortPostCards(sort: SortKey): Promise<boolean> {
    const container = document.getElementById("post-list-container");
    if (!container) return false;

    const posts = Array.from(container.querySelectorAll<HTMLElement>(":scope > .post-card-item"));
    const sortablePosts = posts.filter((post) => post.dataset.postPinned !== "true");
    if (sortablePosts.length < 2) return true;

    const requestId = ++sortRequestId;
    const originalOrder = new Map(sortablePosts.map((post, index) => [post, index]));
    const views = new Map<HTMLElement, number>();

    if (sort === "views" || sort === "views-asc") {
      updateSortUi(sort, true);
      await Promise.all(sortablePosts.map(async (post) => views.set(post, await getPostViews(post))));
      if (requestId !== sortRequestId) return true;
    }

    const sortedPosts = sortablePosts.slice().sort((a, b) => {
      if (sort === "views" || sort === "views-asc") {
        const difference = (views.get(b) || 0) - (views.get(a) || 0);
        if (difference !== 0) return sort === "views" ? difference : -difference;
      }

      const publishedDifference =
        Number(b.dataset.postPublished || 0) - Number(a.dataset.postPublished || 0);
      if (publishedDifference !== 0) {
        return sort === "oldest" ? -publishedDifference : publishedDifference;
      }
      return (originalOrder.get(a) || 0) - (originalOrder.get(b) || 0);
    });

    const orderChanged = sortedPosts.some((post, index) => post !== sortablePosts[index]);
    if (orderChanged) {
      const marker = document.createComment("post-sort-anchor");
      sortablePosts[0].before(marker);
      const fragment = document.createDocumentFragment();
      fragment.append(...sortedPosts);
      marker.replaceWith(fragment);
      window.dispatchEvent(new Event("firefly:post-list-sorted"));
    }
    updateSortUi(sort);
    return true;
  }

  async function applySort(sort: SortKey) {
    const requestId = ++applyRequestId;
    updateSortUi(sort, sort === "views" || sort === "views-asc");
    await sortPostCards(sort);
    if (requestId !== applyRequestId) return;
    window.dispatchEvent(new CustomEvent("firefly:sort-posts", { detail: { sort } }));
    updateSortUi(sort);
  }

  function closeSortMenu(bar: HTMLElement) {
    const trigger = bar.querySelector<HTMLButtonElement>(".sort-trigger");
    const menu = bar.querySelector<HTMLElement>(".sort-menu");
    if (!trigger || !menu) return;
    trigger.setAttribute("aria-expanded", "false");
    menu.hidden = true;
  }

  function initCategoryBarInteractions() {
    const bar = document.getElementById("category-bar");
    if (!bar || bar.dataset.clickBound === "true") return;

    bar.dataset.clickBound = "true";
    bar.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;

      const trigger = event.target.closest<HTMLButtonElement>(".sort-trigger");
      if (trigger) {
        const menu = bar.querySelector<HTMLElement>(".sort-menu");
        const isOpen = trigger.getAttribute("aria-expanded") === "true";
        if (menu) menu.hidden = isOpen;
        trigger.setAttribute("aria-expanded", isOpen ? "false" : "true");
        return;
      }

      const option = event.target.closest<HTMLButtonElement>(".sort-option");
      if (option && isSortKey(option.dataset.sort || null)) {
        event.preventDefault();
        const sort = option.dataset.sort as SortKey;
        setSortPreference(sort);
        closeSortMenu(bar);
        void applySort(sort);
        return;
      }

      const pill = event.target.closest<HTMLAnchorElement>(".category-pill");
      if (!pill) return;

      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      if (pill.target && pill.target !== "_self") return;

      const targetUrl = new URL(pill.href, window.location.href);
      if (targetUrl.origin !== window.location.origin) return;

      setActiveCategory(bar, targetUrl);
      scrollActiveCategoryIntoView(bar, "auto");
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node) || bar.contains(event.target)) return;
      closeSortMenu(bar);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeSortMenu(bar);
    });
  }

  function initScrollFeatures() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (!scroll) return;

    // 鼠标滚轮横向滚动
    scroll.addEventListener("wheel", (e) => {
      if (scroll.scrollWidth <= scroll.clientWidth) return;
      e.preventDefault();
      scroll.scrollLeft += e.deltaY;
    }, { passive: false });

    // 监听滚动更新提示图标
    scroll.addEventListener("scroll", updateScrollHint);
    window.addEventListener("resize", updateScrollHint);
    updateScrollHint();
  }

  function updateScrollHint() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    const fadeLeft = bar.querySelector<HTMLElement>(".scroll-fade-left");
    const fadeRight = bar.querySelector<HTMLElement>(".scroll-fade-right");
    if (!scroll || !fadeLeft || !fadeRight) return;

    const hasOverflow = scroll.scrollWidth > scroll.clientWidth + 1;
    const atStart = scroll.scrollLeft <= 1;
    const atEnd = scroll.scrollLeft + scroll.clientWidth >= scroll.scrollWidth - 1;

    if (hasOverflow && !atStart) {
      fadeLeft.setAttribute("data-visible", "");
    } else {
      fadeLeft.removeAttribute("data-visible");
    }

    if (hasOverflow && !atEnd) {
      fadeRight.setAttribute("data-visible", "");
    } else {
      fadeRight.removeAttribute("data-visible");
    }
  }

  function applyStoredSort() {
    const sort = getSortPreference();
    updateSortUi(sort);
    void applySort(sort);
  }

  updateCategoryBar();
  initCategoryBarInteractions();
  initScrollFeatures();
  applyStoredSort();
  document.addEventListener("astro:page-load", () => {
    updateCategoryBar();
    initScrollFeatures();
    applyStoredSort();
  });
  document.addEventListener("swup:contentReplaced", () => {
    updateCategoryBar();
    applyStoredSort();
  });
</script>
